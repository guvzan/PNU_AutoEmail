<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Upload Excel File</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        body {
            font-family: sans-serif;
            padding: 2rem;
        }
        form {
            max-width: 400px;
            margin: auto;
            padding: 2rem;
            border: 1px solid #ccc;
            border-radius: 8px;
        }
        input[type="file"], button {
            display: block;
            margin-top: 1rem;
        }
        .error {
            color: red;
            font-weight: bold;
            margin-top: 1rem;
        }
    </style>
</head>
<body>

<h1 align="center">📄 Завантажте Excel Файл</h1>

<form id="uploadForm" action="/email/upload" method="POST" enctype="multipart/form-data">
    <label for="excel">Вибрати excel файл:</label>
    <input type="file" id="excel" name="excel" accept=".xlsx, .xls" required>
    <button type="submit">Надіслати</button>
    <div id="error" class="error"></div>
</form>

<script>
  const form = document.getElementById('uploadForm');
  const fileInput = document.getElementById('excel');
  const errorDiv = document.getElementById('error');

  form.addEventListener('submit', function (e) {
    const file = fileInput.files[0];

    if (!file) {
      return;
    }

    const allowedExtensions = ['.xlsx', '.xls'];
    const fileName = file.name.toLowerCase();
    const valid = allowedExtensions.some(ext => fileName.endsWith(ext));
    console.log('here')
    console.log('valid', valid)

    if (!valid) {
      e.preventDefault();
      errorDiv.textContent = 'Please upload a valid Excel file (.xlsx or .xls)';
    }
  });
</script>

</body>
</html>
